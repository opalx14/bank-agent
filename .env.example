# ==============================================================================
# OpalX GO / Bank Agent — Environment Configuration (Pure-AVAX 3-Gateway Mode)
# Copy to .env.local (`chmod 600 .env.local`) and NEVER commit secrets.
# ==============================================================================

# --- 1. Mode Switch: true = Demo Account [SANDBOX] | false = Live Business Account [LIVE BANK] ---
OPALX_SANDBOX_MODE="true"

# --- 2. Bank Gateway — PayOS / SePay NAPAS 247 & Live Enterprise (Side 2 & Side 1) ---
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
# Optional SePay webhook Authorization Apikey secret
SEPAY_WEBHOOK_API_KEY=""
OPALX_VIETQR_BANK_BIN="970422"
OPALX_VIETQR_BANK_NAME="MB Bank"
OPALX_VIETQR_ACCOUNT_NO=""
OPALX_VIETQR_ACCOUNT_NAME=""
OPALX_LIVE_MERCHANT_NAME=""
OPALX_LIVE_MERCHANT_TAX_ID=""
OPALX_LIVE_ENTERPRISE_ADDRESS=""

# --- 3. OpalXGo — Commitment Pepper & Avalanche Fuji (43113) Pure-AVAX Contracts ---
# Get testnet AVAX from: https://core.app/tools/testnet-faucet/?subnet=c&token=c
OPALX_COMMITMENT_PEPPER="replace-with-random-server-pepper"
AVALANCHE_FUJI_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
AVALANCHE_ISSUER_PRIVATE_KEY=""
OPALX_ALLOW_LIVE_FUJI_TX="true"

NEXT_PUBLIC_APP_ORIGIN="http://127.0.0.1:5238"
NEXT_PUBLIC_AVALANCHE_CHAIN_ID="43113"
NEXT_PUBLIC_ENTERPRISE_GATEWAY_ADDRESS=""
NEXT_PUBLIC_BANK_GATEWAY_ADDRESS=""
NEXT_PUBLIC_OPALX_CORE_ADDRESS=""

# --- 4. Optional Privy Popup-Free Delegated Signer (Key Quorum P-256 Policy) ---
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
PRIVY_AGENT_SIGNER_ID=""
PRIVY_AGENT_POLICY_ID=""
PRIVY_AGENT_PRIVATE_KEY=""
AGENT_MAX_AVAX="0.01"

# --- 5. Server Auth, Admin & Session Security ---
# HMAC-SHA256 signing secret for signed HttpOnly wallet sessions (required in production)
OPALX_SESSION_SECRET=""
# Operator API key for protected administrative mutations (kill-switch, bank rails, bank config)
OPALX_ADMIN_API_KEY=""

# --- 6. Optional Supabase Postgres Ledger Snapshot Sync ---
# Configure both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to mirror ledger JSON snapshots to Postgres
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
OPALX_SUPABASE_LEDGER_TABLE="opalx_ledger_snapshots"
