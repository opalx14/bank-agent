<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/opalx_bg_surface"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn nhanh máy chủ OpalX GO"
        android:textColor="@color/opalx_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cài đặt URL ưu tiên khi khởi động (mặc định USB 127.0.0.1:5238)."
        android:textColor="@color/opalx_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnPresetUsb"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="USB Cable (ADB): http://127.0.0.1:5238"
        android:textColor="@color/opalx_text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPresetWifi"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Wi-Fi LAN: http://192.168.1.7:5238"
        android:textColor="@color/opalx_text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPresetCloud"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_btn_secondary"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="HTTPS Cloud (Mọi mạng / 4G): https://complement-cross-milan-instructors.trycloudflare.com"
        android:textColor="@color/opalx_text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Hoặc nhập URL tùy chỉnh (HTTPS / ngrok / IP LAN):"
        android:textColor="@color/opalx_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:hint="https://your-ngrok-or-lan-url"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/opalx_text_primary"
        android:textColorHint="@color/opalx_text_muted"
        android:textSize="13sp" />

</LinearLayout>
