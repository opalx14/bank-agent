{
  "name": "opalx-bank-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 5238",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 5238",
    "typecheck": "tsc --noEmit",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "fuji:wallet": "bun scripts/deploy-fuji.ts --check-only",
    "contracts:deploy:fuji": "bun scripts/deploy-fuji.ts",
    "guard:check": "cargo check --manifest-path crates/opalx-guard/Cargo.toml",
    "guard:test": "cargo test --manifest-path crates/opalx-guard/Cargo.toml",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/integration",
    "eval": "bun eval/run-eval.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@payos/node": "^2.0.6",
    "@vinext/cloudflare": "^1.4.0",
    "@x402/core": "~2.28.0",
    "@x402/evm": "~2.28.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.47.5",
    "vinext": "^1.4.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vite-css-modules": "^1.16.1"
  },
  "packageManager": "bun@1.2.18",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "type": "module"
}
